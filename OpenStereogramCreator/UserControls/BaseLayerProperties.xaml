<UserControl x:Class="OpenStereogramCreator.BaseLayerProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:layerTypes="clr-namespace:OpenStereogramCreator.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance layerTypes:LayerBase}">
	<StackPanel Margin="0">
		<Grid Margin="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<DockPanel Grid.Column="0">
				<Label Width="75">Visible</Label>
				<CheckBox IsChecked="{Binding Path=Visible}" VerticalAlignment="Center" />
			</DockPanel>

			<Button Grid.Column="1" FontFamily="{StaticResource FontAwesomeRegular}" Style="{StaticResource IconButton}" Click="LayerUpClick" >
				<TextBlock Margin="0" Padding="3">&#xf151;</TextBlock>
			</Button>
			<Button Grid.Column="2" FontFamily="{StaticResource FontAwesomeRegular}" Style="{StaticResource IconButton}" Click="LayerDownClick">
				<TextBlock Margin="0" Padding="3">&#xf150;</TextBlock>
			</Button>

			<Button Grid.Column="3" FontFamily="{StaticResource FontAwesomeRegular}" Style="{StaticResource IconButton}" Click="DeleteLayerClick" HorizontalAlignment="Right">
				<TextBlock Margin="0" Padding="3" HorizontalAlignment="Left">&#xf1f8;</TextBlock>
			</Button>
		</Grid>

		<DockPanel>
			<Label Width="75">Name</Label>
			<TextBox Text="{Binding Path=Name}" Height="24" Width="180"></TextBox>
		</DockPanel>
		<DockPanel>
			<Label Width="75">Blending</Label>
			<ComboBox x:Name="BlendingModeComboBox" SelectedItem="{Binding Path=BlendingMode}" Width="180"></ComboBox>
		</DockPanel>
		<DockPanel>
			<Label Width="75">Opacity</Label>
			<Slider x:Name="OversamplingSlider" IsSnapToTickEnabled="False" Value="{Binding Path=Opacity}" Maximum="1" Minimum="0" SmallChange="0.01" TickPlacement="Both" Width="180"/>
		</DockPanel>
	</StackPanel>
</UserControl>
